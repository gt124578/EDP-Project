import numpy as np
import matplotlib.pyplot as plt
import sympy as sp

# Paramètres
L = 1          # Longueur de la barre
nx = 100       # Nombre de points en espace
D = 0.01       # Diffusivité thermique
T = 2.0        # Temps total
dx = L / (nx - 1)       # Discrétisation spatiale
C = 0.03       # Coefficient pour le terme advection

# Calcul d'un dt respectant la condition CFL
dt_diff = dx**2 / (2 * D)  # Pour la diffusion
dt_adv = dx / C            # Pour l'advection
dt = min(dt_diff, dt_adv) * 0.9  # Facteur de sécurité
nt = int(T / dt)

x = np.linspace(0, L, nx)
u = np.zeros(nx)        # Initialisation de la température
u_mat = np.zeros((nt, nx))  # Matrice de solution
u_mat[0, :] = u

# Fonction exacte
def u_exact(x, t, D=D):
    return np.sin(np.pi * x) * (1 + t)

# Fonction source
x_sym, t_sym = sp.symbols('x t')
u_ex = (1 / sp.sqrt(2 * sp.pi)) * sp.exp(-x_sym**2 / 2) * (1 + t_sym)
du_dx = sp.diff(u_ex, x_sym)
du_dx_2 = sp.diff(du_dx, x_sym)
du_dt = sp.diff(u_ex, t_sym)
f = du_dt - D * du_dx_2 + C * du_dx

def fonction_f(n, L=L, f=f):
    return float(f.subs({x_sym: L, t_sym: n * dt}))

# Boucle temporelle
for n in range(1, nt):
    u_new = u.copy()
    for i in range(1, nx - 1):
        # Schéma explicite avec diffusion et advection (upwind)
        u_new[i] = (u[i]
                    + D * dt / dx**2 * (u[i + 1] - 2 * u[i] + u[i - 1])
                    - C * dt / dx * (u[i] - u[i - 1])  # Upwind
                    + fonction_f(n) * dt)
    u = u_new.copy()
    u_mat[n, :] = u

# Tracé
plt.figure(1)
time_steps_to_plot = [0, int(0.5 / dt), int(1.0 / dt), nt - 1]

for t_index in time_steps_to_plot:
    plt.plot(x, u_mat[t_index, :], label=f'u_numérique (t={t_index * dt:.2f})')
    #plt.plot(x, u_exact(x, t_index * dt), linestyle='--', label=f'u_exact (t={t_index * dt:.2f})')

plt.xlabel('Position x')
plt.ylabel('u')
plt.title('Évolution de la solution numérique et exacte')
plt.legend()
plt.show()
