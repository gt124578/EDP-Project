import numpy as np
import matplotlib.pyplot as plt

# Paramètres
L = 1.0              # Longueur du domaine
T = 0.5              # Temps total
Nx = 50              # Nombre de points spatiaux
Nt = 1000            # Nombre de points temporels
alpha = 0.01         # Diffusivité
v = 0.1              # Vitesse de convection
f = lambda x, t: 0   # Terme source

# Discrétisation
x = np.linspace(0, L, Nx)
dx = x[1] - x[0]
dt = T / Nt
u = np.zeros((Nt, Nx))

# Conditions initiales
u[0, :] = np.sin(np.pi * x)  # Exemple de condition initiale

# Conditions aux limites
def apply_boundary_conditions(u_n):
    u_n[0] = 0  # Dirichlet à gauche
    u_n[-1] = 0 # Dirichlet à droite
    return u_n

# Boucle temporelle
for n in range(0, Nt - 1):
    for i in range(1, Nx - 1):
        convection = -v * (u[n, i] - u[n, i-1]) / dx
        diffusion = alpha * (u[n, i+1] - 2*u[n, i] + u[n, i-1]) / dx**2
        source = f(x[i], n * dt)
        u[n+1, i] = u[n, i] + dt * (convection + diffusion + source)
    u[n+1, :] = apply_boundary_conditions(u[n+1, :])

# Affichage des résultats
for n in range(0, Nt, Nt // 10):
    plt.plot(x, u[n, :], label=f"t={n*dt:.2f}")
plt.xlabel("x")
plt.ylabel("u(x, t)")
plt.legend()
plt.title("Équation de la chaleur avec convection et diffusion")
plt.show()
